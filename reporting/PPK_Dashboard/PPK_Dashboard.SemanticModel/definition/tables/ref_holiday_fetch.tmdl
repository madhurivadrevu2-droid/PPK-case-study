	partition ref_holiday_fetch = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ref_holiday_fetch.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"country_code", "year", "status", "holidays_returned", "detail"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"country_code", type text}, {"year", Int64.Type}, {"status", type text}, {"holidays_returned", Int64.Type}, {"detail", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
