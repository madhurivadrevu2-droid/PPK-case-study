	partition dim_office = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_office.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"office", "country", "country_code", "subdivision_code", "region"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"office", type text}, {"country", type text}, {"country_code", type text}, {"subdivision_code", type text}, {"region", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
