	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"date", "year", "quarter", "month", "quarter_of_year", "month_num", "month_name", "month_day", "is_ytd_window", "is_mature_window"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"year", Int64.Type}, {"quarter", type text}, {"month", type text}, {"quarter_of_year", type text}, {"month_num", Int64.Type}, {"month_name", type text}, {"month_day", type text}, {"is_ytd_window", type logical}, {"is_mature_window", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
