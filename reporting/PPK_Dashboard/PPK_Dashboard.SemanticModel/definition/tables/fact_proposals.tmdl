	partition fact_proposals = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_proposals.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"proposal_id", "submitted_date", "office", "practice", "client_name", "proposal_value_usd", "value_flag", "current_status", "close_status", "close_date", "is_open", "is_stale", "is_decided", "is_won", "business_days_to_close", "bd_to_review", "bd_review_to_close", "calendar_days_to_close", "holiday_data_missing", "in_ytd_window", "in_mature_window", "in_submission_gap"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"proposal_id", type text}, {"submitted_date", type date}, {"office", type text}, {"practice", type text}, {"client_name", type text}, {"proposal_value_usd", type number}, {"value_flag", type text}, {"current_status", type text}, {"close_status", type text}, {"close_date", type date}, {"is_open", type logical}, {"is_stale", type logical}, {"is_decided", type logical}, {"is_won", type logical}, {"business_days_to_close", type number}, {"bd_to_review", type number}, {"bd_review_to_close", type number}, {"calendar_days_to_close", type number}, {"holiday_data_missing", type logical}, {"in_ytd_window", type logical}, {"in_mature_window", type logical}, {"in_submission_gap", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
