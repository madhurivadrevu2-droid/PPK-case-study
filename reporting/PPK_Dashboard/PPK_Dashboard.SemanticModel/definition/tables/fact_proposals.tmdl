table fact_proposals
	lineageTag: b4866855-09b5-569e-921d-e4f811ecafb6

	measure Proposals = COUNTROWS(fact_proposals)
		formatString: #,0
		lineageTag: 423ed4b6-7a36-5b57-9db5-ce3039cda051

	measure 'Value USD' = SUM(fact_proposals[proposal_value_usd])
		formatString: $#,0
		lineageTag: fcb8439b-644d-5665-bdf4-ed6411f650a2

	measure Won = CALCULATE([Proposals], fact_proposals[close_status] = "Won")
		formatString: #,0
		lineageTag: a88b8252-9f87-5824-bb80-4093ce9928b3

	measure Decided = CALCULATE([Proposals], fact_proposals[is_decided] = TRUE())
		formatString: #,0
		lineageTag: d81b6697-bc96-5981-9d6d-3f620cff94a9

	measure 'Win Rate' = DIVIDE([Won], [Decided])
		formatString: 0.0%
		lineageTag: e259f287-d23e-5aa6-8c57-f414f8515fc5

	measure 'Won Value USD' = CALCULATE([Value USD], fact_proposals[close_status] = "Won")
		formatString: $#,0
		lineageTag: 069a371a-6085-5a5d-bdff-b43969c427e4

	measure 'Median Days to Decision' = CALCULATE(MEDIAN(fact_proposals[business_days_to_close]), fact_proposals[is_decided] = TRUE())
		formatString: 0
		lineageTag: 33a83bc1-6cc8-531f-841f-3bedad81d8b4

	measure 'P90 Days to Decision' = CALCULATE(PERCENTILE.INC(fact_proposals[business_days_to_close], 0.9), fact_proposals[is_decided] = TRUE())
		formatString: 0
		lineageTag: e8e398ca-9c59-5c5d-b311-ba61d58c8b9b

	measure 'Median Days to Review' = CALCULATE(MEDIAN(fact_proposals[bd_to_review]), fact_proposals[is_decided] = TRUE())
		formatString: 0
		lineageTag: 32db07dc-b9ba-5e0b-ad54-8fac551ad6c7

	measure 'Median Review to Decision' = CALCULATE(MEDIAN(fact_proposals[bd_review_to_close]), fact_proposals[is_decided] = TRUE())
		formatString: 0
		lineageTag: 81941994-6a9d-5067-b8f8-7c27cf824ad7

	measure 'Share Over 30 Days' = DIVIDE(CALCULATE([Proposals], fact_proposals[is_decided] = TRUE(), fact_proposals[business_days_to_close] > 30), [Decided])
		formatString: 0%
		lineageTag: 616e7914-60df-5766-863e-d43753a2805d

	measure 'Open Pipeline USD' = CALCULATE([Value USD], fact_proposals[is_open] = TRUE())
		formatString: $#,0
		lineageTag: 934fe540-673c-5dd6-b3da-afa6b0da4aed

	measure 'Share Still Open' = DIVIDE(CALCULATE([Proposals], fact_proposals[is_open] = TRUE()), [Proposals])
		formatString: 0%
		lineageTag: f3ced9fa-934b-5151-a6a9-85b0ec4d2e1a

	measure 'Proposals 2026 YTD' = CALCULATE([Proposals], dim_date[year] = 2026, dim_date[is_ytd_window] = TRUE())
		formatString: #,0
		lineageTag: c487924e-bf51-5932-854a-e71c9a3d707c

	measure 'Proposals 2025 YTD' = CALCULATE([Proposals], dim_date[year] = 2025, dim_date[is_ytd_window] = TRUE())
		formatString: #,0
		lineageTag: 616ed75d-3344-5665-937b-e2d763fcccb6

	measure 'Volume Growth %' = DIVIDE([Proposals 2026 YTD] - [Proposals 2025 YTD], [Proposals 2025 YTD])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 753e9c0d-9293-5cd2-95c5-4ef8f07c202c

	measure 'Volume Growth % Gap-adjusted' = VAR c = CALCULATE([Proposals 2026 YTD], fact_proposals[in_submission_gap] = FALSE()) VAR p = CALCULATE([Proposals 2025 YTD], fact_proposals[in_submission_gap] = FALSE()) RETURN DIVIDE(c - p, p)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: be7a7aed-17cb-5f5a-819d-5d2b665df4dc

	measure 'Value 2026 YTD' = CALCULATE([Value USD], dim_date[year] = 2026, dim_date[is_ytd_window] = TRUE())
		formatString: $#,0
		lineageTag: 687b77f1-1a5c-55c2-9116-03ed608cb02a

	measure 'Value 2025 YTD' = CALCULATE([Value USD], dim_date[year] = 2025, dim_date[is_ytd_window] = TRUE())
		formatString: $#,0
		lineageTag: 17a2367d-7ba2-5590-851c-2a276f2fee91

	measure 'Value Growth %' = DIVIDE([Value 2026 YTD] - [Value 2025 YTD], [Value 2025 YTD])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 19198ddd-6398-56b9-a4da-4ecefc481d59

	measure 'Value Growth % Gap-adjusted' = VAR c = CALCULATE([Value 2026 YTD], fact_proposals[in_submission_gap] = FALSE()) VAR p = CALCULATE([Value 2025 YTD], fact_proposals[in_submission_gap] = FALSE()) RETURN DIVIDE(c - p, p)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 0b4ff6ac-797c-5c6e-8733-c58274ab042c

	measure 'Proposals Complete Months' = IF(MAX(dim_date[month]) = "2026-10", BLANK(), [Proposals])
		formatString: #,0
		lineageTag: d00dd748-4c78-5e95-bfe6-04ad0d4317d3

	measure 'Win Rate 2026' = CALCULATE([Win Rate], dim_date[year] = 2026, dim_date[is_mature_window] = TRUE())
		formatString: 0.0%
		lineageTag: c21b4aef-8ff1-5d6e-adff-5d7601f5e7b5

	measure 'Win Rate 2025' = CALCULATE([Win Rate], dim_date[year] = 2025, dim_date[is_mature_window] = TRUE())
		formatString: 0.0%
		lineageTag: d539176d-bc30-5c15-9191-6133fcc2eb73

	measure 'Win Rate Change pp' = IF(ISBLANK([Win Rate 2025]) || ISBLANK([Win Rate 2026]), BLANK(), ([Win Rate 2026] - [Win Rate 2025]) * 100)
		formatString: +0.0;-0.0;0.0
		lineageTag: e28fde69-09a0-5a49-882b-3323df6c689b

	measure 'Won Value 2026' = CALCULATE([Won Value USD], dim_date[year] = 2026, dim_date[is_mature_window] = TRUE())
		formatString: $#,0
		lineageTag: 176e2b80-1ee0-5742-a8ec-eca224690a62

	measure 'Won Value 2025' = CALCULATE([Won Value USD], dim_date[year] = 2025, dim_date[is_mature_window] = TRUE())
		formatString: $#,0
		lineageTag: 584f1de6-ca84-55c1-a835-a711345ff9a6

	measure 'Won Value Growth %' = DIVIDE([Won Value 2026] - [Won Value 2025], [Won Value 2025])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 067db095-e3f9-5023-8559-54a9ee2214a1

	measure 'Median Days 2026' = CALCULATE([Median Days to Decision], dim_date[year] = 2026, dim_date[is_mature_window] = TRUE())
		formatString: 0
		lineageTag: c1bb8b60-83e3-5b51-bac1-f6fdef1faef1

	measure 'Median Days 2025' = CALCULATE([Median Days to Decision], dim_date[year] = 2025, dim_date[is_mature_window] = TRUE())
		formatString: 0
		lineageTag: c70fe73e-275e-5ab3-9993-a1991ed06bf9

	measure 'Rescaled Values' = CALCULATE([Proposals], fact_proposals[value_flag] <> "ok")
		formatString: #,0
		lineageTag: fe2c4c81-9a6c-5a62-8ec3-949cb88193a9

	measure 'Share Without Holiday Data' = DIVIDE(CALCULATE([Proposals], fact_proposals[holiday_data_missing] = TRUE()), [Proposals])
		formatString: 0.0%
		lineageTag: e0f639b9-05e8-5165-acfd-529b425afb18

