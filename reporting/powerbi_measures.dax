// PPK proposal performance - DAX measures
// Create a table called _Measures (Enter data -> one blank column) and add each measure below.
// Model: fact_proposals[submitted_date] -> dim_date[date] (dim_date marked as date table),
//        fact_proposals[office] -> dim_office[office], fact_proposals[practice] -> dim_practice[practice]

// ---------- Volume and value ----------
Proposals = COUNTROWS ( fact_proposals )

Value USD = SUM ( fact_proposals[proposal_value_usd] )

Median Value USD = MEDIAN ( fact_proposals[proposal_value_usd] )

Open Pipeline = CALCULATE ( [Proposals], fact_proposals[is_open] = TRUE () )

// ---------- Win rate: Won / (Won + Lost); Withdrawn and open excluded ----------
Won = CALCULATE ( [Proposals], fact_proposals[close_status] = "Won" )

Decided = CALCULATE ( [Proposals], fact_proposals[close_status] IN { "Won", "Lost" } )

Win Rate = DIVIDE ( [Won], [Decided] )

Withdrawal Rate =
DIVIDE (
    CALCULATE ( [Proposals], fact_proposals[close_status] = "Withdrawn" ),
    CALCULATE ( [Proposals], NOT ISBLANK ( fact_proposals[close_status] ) )
)

// ---------- Turnaround: business days submission -> Won/Lost ----------
Median Turnaround (bd) =
CALCULATE (
    MEDIAN ( fact_proposals[business_days_to_close] ),
    fact_proposals[close_status] IN { "Won", "Lost" }
)

Mean Turnaround (bd) =
CALCULATE (
    AVERAGE ( fact_proposals[business_days_to_close] ),
    fact_proposals[close_status] IN { "Won", "Lost" }
)

P90 Turnaround (bd) =
CALCULATE (
    PERCENTILE.INC ( fact_proposals[business_days_to_close], 0.9 ),
    fact_proposals[close_status] IN { "Won", "Lost" }
)

Median Submit to Review (bd) =
CALCULATE ( MEDIAN ( fact_proposals[bd_to_review] ), fact_proposals[close_status] IN { "Won", "Lost" } )

Median Review to Decision (bd) =
CALCULATE ( MEDIAN ( fact_proposals[bd_review_to_close] ), fact_proposals[close_status] IN { "Won", "Lost" } )

// ---------- Like-for-like growth vs prior year ----------
// Volume/value: put dim_date[is_ytd_window] = TRUE as a page filter (1 Jan - 15 Oct each year).
// SAMEPERIODLASTYEAR shifts whatever dates are in context back one year, so slicers still work.
Proposals PY = CALCULATE ( [Proposals], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Value USD PY = CALCULATE ( [Value USD], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Volume Growth % = DIVIDE ( [Proposals] - [Proposals PY], [Proposals PY] )

Value Growth % = DIVIDE ( [Value USD] - [Value USD PY], [Value USD PY] )

// Win rate / turnaround: mature cohorts only (submitted 1 Jan - 15 Jul) so recent open
// proposals do not bias the comparison (right-censoring).
Win Rate (mature) = CALCULATE ( [Win Rate], KEEPFILTERS ( dim_date[is_mature_window] = TRUE () ) )

Win Rate PY (mature) =
CALCULATE (
    [Win Rate],
    SAMEPERIODLASTYEAR ( dim_date[date] ),
    dim_date[is_mature_window] = TRUE ()
)

Win Rate Change (pp) = ( [Win Rate (mature)] - [Win Rate PY (mature)] ) * 100

Median Turnaround (mature) =
CALCULATE ( [Median Turnaround (bd)], KEEPFILTERS ( dim_date[is_mature_window] = TRUE () ) )

Median Turnaround PY (mature) =
CALCULATE (
    [Median Turnaround (bd)],
    SAMEPERIODLASTYEAR ( dim_date[date] ),
    dim_date[is_mature_window] = TRUE ()
)

// ---------- Data quality ----------
Rescaled Values = CALCULATE ( [Proposals], fact_proposals[value_flag] <> "ok" )

Proposals Without Holiday Data = CALCULATE ( [Proposals], fact_proposals[holiday_data_missing] = TRUE () )

Share Without Holiday Data = DIVIDE ( [Proposals Without Holiday Data], [Proposals] )
